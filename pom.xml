<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- DEV-V5：废弃 pw-framework-bom 父子关系，改为完全自包含——所有依赖/插件版本在此显式声明，
         不再继承任何外部 BOM 或父 POM 的 dependencyManagement / build 插件。 -->
    <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
    <artifactId>test-automation</artifactId>
    <version>1.0.1</version>
    <name>Test Automation</name>
    <description>Cucumber test suite: features, step definitions, CucumberTestRunnerIT. Aggregates all framework modules.</description>

    <properties>
        <framework.version>1.0.1</framework.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Failsafe passes this tag expression to the single CucumberTestRunnerIT entry point.
             Examples: mvn verify -Dtags='@login' or mvn verify -Dtags='@route or @api'.
             Use -Dit.test=<class> for targeted runner debugging; it overrides Failsafe includes/excludes. -->

        <!-- Set true only when running Cucumber E2E without unit tests:
             mvn clean verify -Dskip.unit.tests=true -Dtags='@route-e2e'.
             The default keeps unit tests enabled. Do not use -DskipTests, which also skips Failsafe. -->
        <skip.unit.tests>true</skip.unit.tests>

        <!-- Align retry behavior with the master branch: no automatic reruns by default.
             CI can opt in with -DrerunFailingTestsCount=N when a flaky-test buffer is required. -->
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-reports</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-api-core</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-web-ui</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <!-- Route V2 is the sole route implementation; business tests use RouteDsl. -->
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-route</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-codegen</artifactId>
            <version>${framework.version}</version>
        </dependency>

        <!-- External libraries used by this test suite are declared explicitly and test-scoped. -->
        <!-- M3：移除 serenity-model/core（测试代码已无 Serenity 引用；@Step/@Steps/@Shared 经 pw-reports shim 解析）。 -->

        <!-- DEV-V5 去 Serenity 后，框架改用 Playwright，测试代码已无任何 org.openqa.selenium / io.appium 引用；
             selenium-java / selenium-support / htmlunit3-driver / appium java-client 均不再需要，已移除。 -->

        <!-- M3：移除 serenity-cucumber/screenplay/rest-assured（runner 已切纯 Cucumber；rest-assured 经 pw-api-core 传入）。 -->
        <!-- JUnit 4：本模块单元用例直接使用 org.junit.Test/@RunWith，Cucumber runner 也基于 io.cucumber.junit
             （JUnit4 桥接）@RunWith(Cucumber.class)；与已废弃的 CucumberWithSerenity 无关。 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber JUnit4 运行器（io.cucumber.junit.Cucumber + @RunWith(Cucumber.class)），供本模块 Cucumber *IT runner 使用；Serenity 已移除。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <!-- Cucumber 运行时/步骤定义/DataTable 依赖：BOM 已废弃，版本在此显式声明（与框架 cucumber 7.34.9 对齐）。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-core</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <!-- 统一测试 classpath 的 cucumber 版本与框架 cucumber-core（7.34.9）对齐，避免 cucumber 内置 shade 的 jackson 类 NoClassDefFoundError。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-gherkin</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-plugin</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>datatable</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.62.0</version>
            <scope>test</scope>
        </dependency>
        <!-- RestAssured needs commons-logging at runtime; declare it explicitly for tests. -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Mockito supports isolated tests that mock Playwright pages and contexts. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.5.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Pin inline mock-maker dependencies together to avoid conflicts with transitive versions.
                 byte-buddy 必须停留在 1.12.x 以匹配 mockito 4.5.1 的内联 mock maker（框架侧 Playwright 用的 1.17.8 不适用）。 -->
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.12.23</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.objenesis</groupId>
            <artifactId>objenesis</artifactId>
            <version>3.2</version>
            <scope>test</scope>
        </dependency>
        <!-- H2 supports persistence tests without requiring an external database. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compile with Java 21 (self-contained: no parent supplies the compiler configuration). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!-- Surefire runs unit tests; Failsafe runs integration tests. Keep the E2E runner out of Surefire. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Set true to run Cucumber E2E without unit tests. Do not use -DskipTests, which also skips Failsafe. -->
                    <skipTests>${skip.unit.tests}</skipTests>

                    <!-- The Cucumber *IT runner belongs to Failsafe, not the unit-test phase. -->

                    <!-- -Dtest can override Surefire includes; use -Dskip.unit.tests=true to preserve Failsafe E2E execution. -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit47</artifactId>
                        <version>3.2.5</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <useFile>false</useFile>
                    <rerunFailingTestsCount>${rerunFailingTestsCount}</rerunFailingTestsCount>
                    <!-- Use one CucumberTestRunnerIT entry point and select features with tags to avoid duplicate scenarios. -->
                    <includes>
                        <include>**/CucumberTestRunnerIT.java</include>
                    </includes>
                    <excludes>
                        <!-- These runners are opt-in only and excluded from the default verify run. -->
                        <exclude>**/CucumberParallelLogonRunnerIT.java</exclude>
                        <exclude>**/CucumberConcurrentLogonRunnerIT.java</exclude>
                    </excludes>
                    <testClassesDirectory>${project.build.testOutputDirectory}</testClassesDirectory>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <useModulePath>false</useModulePath>
                    <!-- Open JDK internals required by ByteBuddy, Mockito, and Groovy reflection in the test runtime. -->
                    <argLine>-XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${tags}</cucumber.filter.tags>
                    </systemPropertyVariables>
                    <!-- Fail when no integration tests match instead of silently generating an empty report. -->
                    <failIfNoTests>true</failIfNoTests>
                    <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            </plugins>
    </build>

</project>
