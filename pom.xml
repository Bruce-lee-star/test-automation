<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>pw-framework-bom</artifactId>
        <version>1.0.1</version>
        <relativePath/>
    </parent>

    <artifactId>test-automation</artifactId>
    <name>Test Automation</name>
    <description>Cucumber test suite: features, step definitions, CucumberTestRunnerIT. Aggregates all framework modules.</description>

    <properties>
        <framework.version>1.0.1</framework.version>
        <!-- Failsafe passes this tag expression to the single CucumberTestRunnerIT entry point.
             Examples: mvn verify -Dtags='@login' or mvn verify -Dtags='@route or @api'.
             Use -Dit.test=<class> for targeted runner debugging; it overrides Failsafe includes/excludes. -->
        <tags>@test</tags>

        <!-- Set true only when running Cucumber E2E without unit tests:
             mvn clean verify -Dskip.unit.tests=true -Dtags='@route-e2e'.
             The default keeps unit tests enabled. Do not use -DskipTests, which also skips Failsafe. -->
        <skip.unit.tests>false</skip.unit.tests>

        <!-- Align retry behavior with the master branch: no automatic reruns by default.
             CI can opt in with -DrerunFailingTestsCount=N when a flaky-test buffer is required. -->
        <rerunFailingTestsCount>0</rerunFailingTestsCount>

        <!-- This standalone test-suite module has no production sources, and the framework Checkstyle
             config resolves relative to the framework reactor rather than this repository. Keep the
             module-level check disabled; framework production modules enforce the Checkstyle gate. -->
        <checkstyle.skip>true</checkstyle.skip>

        <!-- SSO 跨 fork 分区（设计文档 §9.5）：fork 索引与 stride，CI 经 -D 注入；
             本地默认 0 / 4（单 fork，零行为变化）。 -->
        <fork.index>0</fork.index>
        <sso.fork.user.stride>4</sso.fork.user.stride>
        <!-- failsafe 跨 JVM fork 数（§9.5）：默认 1（与历史一致）；CI 经 -DtestForkCount=N 开启多 fork。 -->
        <testForkCount>1</testForkCount>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-reports</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-api-core</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-web-ui</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <!-- Route V2 is the sole route implementation; business tests use RouteDsl. -->
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-route</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-codegen</artifactId>
            <version>${framework.version}</version>
        </dependency>

        <!-- External libraries used by this test suite are declared explicitly and test-scoped. -->
        <!-- M3：移除 serenity-model/core（测试代码已无 Serenity 引用；@Step/@Steps/@Shared 经 pw-reports shim 解析）。 -->

        <!-- DEV-V5 去 Serenity 后，框架改用 Playwright，测试代码已无任何 org.openqa.selenium / io.appium 引用；
             selenium-java / selenium-support / htmlunit3-driver / appium java-client 均不再需要，已移除。 -->

        <!-- M3：移除 serenity-cucumber/screenplay/rest-assured（runner 已切纯 Cucumber；rest-assured 经 pw-api-core 传入）。 -->
        <!-- JUnit 4：本模块单元用例直接使用 org.junit.Test/@RunWith，Cucumber runner 也基于 io.cucumber.junit
             （JUnit4 桥接）@RunWith(Cucumber.class)；与已废弃的 CucumberWithSerenity 无关。 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber JUnit4 运行器（io.cucumber.junit.Cucumber + @RunWith(Cucumber.class)），供本模块 Cucumber *IT runner 使用；Serenity 已移除。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Declare the Cucumber runtime, step-definition, and DataTable dependencies explicitly;
             versions are managed centrally by the framework BOM. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 统一测试 classpath 的 cucumber 版本与框架 cucumber-core（7.34.9）对齐，避免 cucumber 内置 shade 的 jackson 类 NoClassDefFoundError。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-gherkin</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-plugin</artifactId>
            <version>7.34.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>datatable</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- RestAssured needs commons-logging at runtime; declare it explicitly for tests. -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Mockito supports isolated tests that mock Playwright pages and contexts. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Pin inline mock-maker dependencies together to avoid conflicts with transitive versions. -->
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.12.23</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.objenesis</groupId>
            <artifactId>objenesis</artifactId>
            <version>3.2</version>
            <scope>test</scope>
        </dependency>
        <!-- H2 supports persistence tests without requiring an external database. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire runs unit tests; Failsafe runs integration tests. Keep the E2E runner out of Surefire. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Set true to run Cucumber E2E without unit tests. Do not use -DskipTests, which also skips Failsafe. -->
                    <skipTests>${skip.unit.tests}</skipTests>

                    <!-- The Cucumber *IT runner belongs to Failsafe, not the unit-test phase. -->

                    <!-- -Dtest can override Surefire includes; use -Dskip.unit.tests=true to preserve Failsafe E2E execution. -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit47</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <useFile>false</useFile>
                    <rerunFailingTestsCount>${rerunFailingTestsCount}</rerunFailingTestsCount>
                    <forkCount>${testForkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- Do not impose a fixed fork timeout on environment-dependent E2E runs. -->
                    <!-- Use one CucumberTestRunnerIT entry point and select features with tags to avoid duplicate scenarios. -->
                    <includes>
                        <include>**/CucumberTestRunnerIT.java</include>
                    </includes>
                    <excludes>
                        <!-- These runners are opt-in only and excluded from the default verify run. -->
                        <exclude>**/CucumberParallelLogonRunnerIT.java</exclude>
                        <exclude>**/CucumberConcurrentLogonRunnerIT.java</exclude>
                    </excludes>
                    <testClassesDirectory>${project.build.testOutputDirectory}</testClassesDirectory>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <useModulePath>false</useModulePath>
                    <!-- Open JDK internals required by ByteBuddy, Mockito, and Groovy reflection in the test runtime. -->
                    <argLine>@{jacocoArgLine} -XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED -Dfork.index=${fork.index} -Dsso.fork.user.stride=${sso.fork.user.stride}</argLine>
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${tags}</cucumber.filter.tags>
                        <!-- 框架 Cucumber 插件（FrameworkCucumberEventListener + PwReportPlugin）与
                             ObjectFactory（PwReportObjectFactory）由框架自带 Runner（CucumberWithPw）在构造
                             Cucumber 前经系统属性注入注册，此处不再声明，避免同一插件被注册两次。 -->
                        <!-- D-4: env/env.code/base.url default empty (no environment metrics injected); runtime env resolved via Gherkin step logon DBB "<env>" (resolveEnv), no longer via Maven profile -->
                        <env>${env}</env>
                        <env.code>${env.code}</env.code>
                        <base.url>${base.url}</base.url>
                    </systemPropertyVariables>
                    <!-- Fail when no integration tests match instead of silently generating an empty report. -->
                    <failIfNoTests>true</failIfNoTests>
                    <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate a JaCoCo report without enforcing a coverage threshold. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            </plugins>
    </build>

    <profiles>
        <!-- Opt-in engine-level parallel execution; the default test run remains sequential. -->
        <profile>
            <id>parallel</id>
            <properties>
                <!-- Defaults for the parallel profile; CI can override both values with Maven properties. -->
                <parallelism>4</parallelism>
                <maxPoolSize>8</maxPoolSize>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- Cucumber parallel execution remains disabled unless -Pparallel is selected. -->
                                <cucumber.execution.parallel.enabled>true</cucumber.execution.parallel.enabled>
                                <cucumber.execution.parallel.config.fixed.parallelism>${parallelism}</cucumber.execution.parallel.config.fixed.parallelism>
                                <cucumber.execution.parallel.config.fixed.max-pool-size>${maxPoolSize}</cucumber.execution.parallel.config.fixed.max-pool-size>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
