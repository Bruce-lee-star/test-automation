            <!-- 猸?姹囨€绘姤鍛婄敓鎴愶紙鍘?T2-8 鑷姩鍖栵級锛氭湰妯″潡鍐呰仈 exec-maven-plugin 鍦?verify 闃舵瑙﹀彂锛?
                 鐢熷懡鍛ㄦ湡涓婃櫄浜庝笂鏂?serenity:aggregate 鎵€鍦ㄧ殑 post-integration-test锛?
                 椤哄簭鐢?Maven 闃舵淇濊瘉锛屼笉鍐嶄緷璧栧悓闃舵鍐呯殑鎻掍欢澹版槑椤哄簭銆?
                 浠呮湰妯″潡锛堝敮涓€鍚?framework-reporting 鐨勪笟鍔℃祴璇曟ā鍧楋級鎵ц锛屾牴涓庢鏋舵ā鍧椾笉瑙﹀彂銆?-->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-summary-report</id>
                        <phase>${summary.report.phase}</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.hsbc.cmb.hk.dbb.automation.framework.common.reporting.SummaryReportGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/site/serenity</argument>
                            </arguments>
                            <!-- 蹇呴』鐢?test 浣滅敤鍩燂細SummaryReportGenerator 渚濊禆 net.thucydides.model.*锛坰erenity-model锛夛紝
                                 鑰屾湰妯″潡鎶?serenity-model 鏄惧紡澹版槑涓?<scope>test</scope>锛圗NG-P0-2锛夆€斺€擬aven 鐨勩€屾渶杩戝０鏄庝紭鍏堛€?
                                 浼氳瀹冧笉鍐嶄互 compile 浣滅敤鍩熶紶閫掞紝鏁?classpathScope=compile 鏃惰繍琛屾湡 NoClassDefFoundError
                                 锛圫ystemEnvironmentVariables锛夛紝瀵艰嚧 mvn verify锛圕I/E-6锛夊湪姹囨€绘姤鍛婂蹇呯劧澶辫触銆?-->
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          猸?寮曟搸绾у苟琛岋紙璇勫08绫?4 / X-1 / W-5锛夛細闇€鍦ㄩ殧绂诲墠缃紙C-1 鐢ㄤ緥绾х粦瀹氾級闂幆鍚庡惎鐢ㄣ€?
          鏄惧紡 -Pparallel 鎵嶅紑鍚?cucumber/junit 骞惰锛涢粯璁?mvn test/verify 浠嶄覆琛岋紝瀹夊叏銆?
        -->
        <profile>
            <id>parallel</id>
            <properties>
                <!-- CON-1 寮曟搸绾у苟琛岋細骞跺彂搴︽棆閽紙CI 鐢?-Dparallelism=N -DmaxPoolSize=M 瑕嗙洊锛?-->
                <parallelism>4</parallelism>
                <maxPoolSize>8</maxPoolSize>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- 寮€鍚?Cucumber 寮曟搸绾у苟琛岋紙榛樿涓茶锛屼粎 -Pparallel 鐢熸晥锛?-->
                                <cucumber.execution.parallel.enabled>true</cucumber.execution.parallel.enabled>
                                <cucumber.execution.parallel.config.fixed.parallelism>${parallelism}</cucumber.execution.parallel.config.fixed.parallelism>
                                <cucumber.execution.parallel.config.fixed.max-pool-size>${maxPoolSize}</cucumber.execution.parallel.config.fixed.max-pool-size>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

