<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
        <artifactId>Automation_WebUI_Framework_BDD</artifactId>
        <version>1.0.1</version>
        <relativePath/>
    </parent>

    <artifactId>test-automation</artifactId>
    <name>Test Automation</name>
    <description>Cucumber/Serenity test suite: features, step definitions, CucumberTestRunnerIT. Aggregates all framework modules.</description>

    <properties>
        <framework.version>1.0.1</framework.version>
        <!-- Cucumber 标签过滤：默认只跑 @test 场景（对齐 master 的 CucumberTestRunnerIT 注解 @test）。
             本属性经 failsafe 的 systemPropertyVariables 注入为 cucumber.filter.tags，是主运行器
             【CucumberTestRunnerIT】的单一事实来源（覆盖其 @CucumberOptions(tags) 注解）。
             定向覆盖（运行器仍只扫 features 目录，标签交给本属性）：
               mvn verify -Dit.test=CucumberTestRunnerIT -Dtags='@login'
               mvn verify -Dit.test=CucumberTestRunnerIT -Dtags='@route or @api'
             注意：failsafe excludes 里那三个并行运行器各自硬编码标签，本属性对其无效，
             故它们不参与默认 verify（定向运行命令见 excludes 注释）。 -->
        <tags>@test</tags>

        <!-- Checkstyle 门禁：本模块【显式关闭】（2026-09-23，本地全量实测）。
             原因：parent 的 configLocation 为 ${maven.multiModuleProjectDirectory}/checkstyle.xml，用于定位
             “框架仓库根”的共享配置；而对作为【独立构建单元】的 test-automation（parent 经 <relativePath/>
             从 .m2 解析），该变量指向本模块目录 → 配置不存在 → 插件在扫描前即硬失败
             （实测：Unable to find configuration file at location: .../test-automation/checkstyle.xml），
             使 `mvn verify` 结构性必红（与测试结果无关），CI 的 e2e job 同样被卡。
             关闭不损失覆盖：① 本模块 src/main/java 为空（无 main 源码）；② parent 的 checkstyle 本就
             includeTestSourceDirectory=false（测试源不入该门禁）→ 此模块没有任何可校验对象。
             框架生产代码的风格门禁仍在框架仓库的 build job 中强制执行（含与 checkstyle-baseline.xml 的计数比对）。 -->
        <checkstyle.skip>true</checkstyle.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-core</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-reports</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-api-core</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-web-ui</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <!-- Route V2：唯一路由实现（V1 pw-route 已整体移除；业务层统一使用 RouteDsl） -->
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-route</artifactId>
            <version>${framework.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hsbc.cmb.dbb.hk.automation</groupId>
            <artifactId>pw-codegen</artifactId>
            <version>${framework.version}</version>
        </dependency>

        <!-- ENG-P0-2：test-automation 实际用到的外部依赖（原由根 <dependencies> 继承，现显式声明；均为测试期） -->
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-model</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 运行 IT 所需（本框架用 Playwright，不真正使用这些 driver）：Serenity 4.2.0 的
             SupportedWebDriver 静态初始化会对 FirefoxDriver/ChromeDriver/InternetExplorerDriver/
             EdgeDriver/SafariDriver/HtmlUnitDriver/AppiumDriver 做 ldc，类缺失即 NoClassDefFoundError
             导致全部 IT 在 Serenity 初始化阶段失败。此处补 test 作用域类路径，使类可加载。 -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>htmlunit3-driver</artifactId>
            <version>${htmlunit3.driver.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- 依赖治理（内网隔离清单）：本框架从不实例化 HtmlUnitDriver（Playwright 驱动），
                     对它的唯一需求是「类可加载」（上方说明的 SupportedWebDriver 静态 ldc）。而
                     htmlunit-websocket-client 仅 HtmlUnit 真正跑 WebSocket 时才会用到，本框架用不到，
                     且该构件命中内网隔离清单，故在此断开（htmlunit 本体经 htmlunit3-driver 传递保留）。 -->
                <exclusion>
                    <groupId>org.htmlunit</groupId>
                    <artifactId>htmlunit-websocket-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>9.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-cucumber</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-screenplay</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.serenity-bdd</groupId>
            <artifactId>serenity-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 4：执行器回退 master 方案（2026-09-27，P0）——CucumberWithSerenity runner（Serenity 主体接管，scenario tags 天然写入 TestOutcome，根治 JUnit5 旁挂下 @firefox/@edge 覆盖失效）。 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- cucumber-junit：@RunWith(CucumberWithSerenity) 的 JUnit4 桥接（serenity-cucumber 依赖其运行器） -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 依赖治理（内网隔离清单）：Cucumber 已从 serenity-model 的传递链路排除，改由使用方显式声明。
             本模块**确实使用**下列三者（Cucumber 运行器 + step 定义 + DataTable 断言），
             故必须显式拉入；版本统一由根 DM 钉 ${cucumber.version}（7.31.0），避免随 Serenity 传递漂移。 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>datatable</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- RestAssured POST 运行期需要 commons-logging(LogFactory)；serenity-* 已将其排除，此处显式补回 -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- selenium-support：serenity 公开 API 引用 org.openqa.selenium.support.ui.*（如 ExpectedCondition）；
             测试源码用到 serenity 的 Wait/ExpectedCondition 签名，须显式声明否则 javac 符号补全会 CompletionFailure -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 纯单测：mock Playwright Page/BrowserContext，校验 start(page) 监听器幂等注册（不依赖浏览器运行时） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Mockito inline mock-maker 的固定配对：byte-buddy 1.12.23 + objenesis 3.2。
                 刻意【不】迁进 <dependencyManagement>：enforcer 的 RequireUpperBoundDeps 把 managed 版本与
                 传递需求比上限（serenity-model 4.3.4 → objenesis 3.4）会判违规；内联声明才被视作本模块显式钉版。 -->
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.12.23</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.objenesis</groupId>
            <artifactId>objenesis</artifactId>
            <version>3.2</version>
            <scope>test</scope>
        </dependency>
        <!-- T0-4 补全收尾：Monitor DB 持久化端到端验证（内存库，无需外部 DB） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 报告目录清理（口径统一：报告只呈现【本次运行】的场景）。
                 背景：Serenity 每次都往同一目录追加场景 JSON/HTML，不清理时汇总报告会把历史运行的行一起算进去
                 （实测同一目录累积 14 个 JSON、同名场景出现两份），"This run" 因此不可信。
                 做法：把 maven-clean-plugin 绑到 pre-integration-test（failsafe 跑 IT 之前），**整个清空**
                 ${project.build.directory}/site/serenity —— 本地跑 verify 无需 mvn clean，口径与 CI 完全一致。
                 与 CI 的等价性：CI 每次运行都是全新工作区（checkout 后 target/ 为空），本就无历史可留；
                 保留历史只在本地连续跑时才有差别，而"报告只代表本次运行"是更重要的一致性要求，故一律全清。
                 副作用（已确认接受）：trend-history/** 也一并清掉，故跨场 FLAKY 徽标（近 5 场失败 ≥3 次）
                 在真实运行中不再可能触发 —— 它是 trend 数据的唯一消费方；若日后要恢复，应把趋势快照移出
                 报告目录（例如 target/trend-history），而不是把历史留在报告目录里与"本次运行"口径打架。
                 另：excludeDefaultDirectories=true 必须保留 —— 否则 clean 目标会连带删掉整个 target/，
                 把已编译产物在 pre-integration-test 阶段清空，直接毁掉本次运行。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>clean-serenity-report</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/site/serenity</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit47</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <useFile>false</useFile>
                    <rerunFailingTestsCount>${rerunFailingTestsCount}</rerunFailingTestsCount>
                    <forkCount>1</forkCount>
                    <!-- Cucumber 主流程整体超时兜底（防 Playwright 导航/采集阻塞拖垮整轮）
                         X-9：提为可配置属性（默认 1800s），CI 可 -DforkedProcessTimeoutInSeconds=N 覆盖 -->
                    <forkedProcessTimeoutInSeconds>${forkedProcessTimeoutInSeconds}</forkedProcessTimeoutInSeconds>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/integration/**/*Test.java</include>
                        <include>**/CucumberTestRunner*.java</include>
                    </includes>
                    <excludes>
                        <!-- 外部依赖运行器：默认不参与 verify（否则默认门禁结构性必红 —— 2026-09-23 本地全量实测）。
                             为何标签过滤拦不住它们：本插件 includes 是 **/*IT.java（无条件全跑），而 -Dtags 注入的
                             cucumber.filter.tags 对 @Suite + @ConfigurationParameter【硬编码标签】的运行器无效
                             （Cucumber 的 JUnit Platform 配置里 @ConfigurationParameter 优先于该属性），
                             于是它们必被执行；而三者分别依赖：
                               ParallelLogon / ConcurrentLogon → 公司 SIT 网络与凭据
                                 （实测 page=...qualityassurance-amh-gbb-sit.p2g.netd2.hsbc.com.hk、
                                   6 个 O63/O38/O88 登录任务约 70s 超时）
                             覆盖不丢：failsafe 的 -Dit.test 会【覆盖】includes/excludes，故定向执行即可（各运行器已硬编码
                             自身标签，无需再传 -Dtags）：
                               mvn verify -Dit.test=CucumberParallelLogonRunnerIT -Dserenity.parallel.for.tests=4 -Dplaywright.browser.headless=true
                               mvn verify -Dit.test=CucumberConcurrentLogonRunnerIT -Dplaywright.browser.headless=true -->
                        <exclude>**/CucumberParallelLogonRunnerIT.java</exclude>
                        <exclude>**/CucumberConcurrentLogonRunnerIT.java</exclude>
                    </excludes>
                    <testClassesDirectory>${project.build.testOutputDirectory}</testClassesDirectory>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <useModulePath>false</useModulePath>
                    <!-- ⚠ JDK16+ 强封装：Serenity REST(RestSpecificationFactory) 在静态初始化时用 ByteBuddy
                         反射注入类，需 java.base 打开 java.lang(ClassLoader.getPackage/defineClass)；
                         java.lang.reflect 供 Mockito/Serenity 反射增强；java.util 供 RestAssured 的 Groovy 反射。 -->
                    <argLine>@{jacocoArgLine} -XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <serenity.outputDirectory>${project.build.directory}/site/serenity</serenity.outputDirectory>
                        <cucumber.filter.tags>${tags}</cucumber.filter.tags>
                        <!-- D-4：环境切换经 -Psit1/sit2/sit3 profile 下发（默认空，不注入 environment 标量键） -->
                        <env>${env}</env>
                        <env.code>${env.code}</env.code>
                        <base.url>${base.url}</base.url>
                    </systemPropertyVariables>
                    <!-- 本地对齐 CI 的「IT 数 > 0」可证伪断言：0 条 IT 命中时响亮失败，
                         而不是在未配置环境（env/base.url 为空）时静默绿。 -->
                    <failIfNoTests>true</failIfNoTests>
                    <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>net.serenity-bdd.maven.plugins</groupId>
                <artifactId>serenity-maven-plugin</artifactId>
                <version>${serenity.version}</version>
                <dependencies>
                    <!-- plexus-archiver 上界钉：serenity-maven-plugin 的插件级传递依赖，
                         dependencyManagement 无法覆盖插件依赖，故在此显式钉版（修复安全漏洞 + 满足内网治理）。
                         版本与根 pom 的 ${plexus.archiver.version} 共用同一属性口径（同一份父 POM 提供），
                         避免框架打包插件（maven-jar-plugin）与本插件两处版本漂移。 -->
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-archiver</artifactId>
                        <version>${plexus.archiver.version}</version>
                    </dependency>
                    <!-- 依赖治理（内网隔离清单）——**插件类路径**是项目级 exclusion 覆盖不到的第二条链路。
                         实测证据：mvn -X 的 "Populating class realm plugin>serenity-maven-plugin" 段此前含
                         org.htmlunit:htmlunit-websocket-client(4.7.0，命中隔离清单)、
                         org.seleniumhq.selenium:htmlunit3-driver(4.38.0，与项目侧 4.23.0 版本偏斜)
                         以及整条 io.cucumber:* 栈。
                         ① 不用的排除：serenity:aggregate 只读 test-outcome JSON 出汇总报告、不驱动浏览器，
                           故对 serenity-core 排除 htmlunit 栈（含 websocket-client）与 htmlunit3-driver。
                         ② 要用的显式声明：Cucumber 是聚合阶段的**运行期必需**（实测：一并排除后报
                           NoClassDefFoundError: io/cucumber/core/resource/Resource），故不排除，改为按项目
                           统一版本显式声明 —— 使插件 realm 用 ${cucumber.version}，而不是由 Serenity 传递的版本。
                         手法同 plexus-archiver：在插件 <dependencies> 内声明同名 GA，就近优先覆盖传递版本。 -->
                    <dependency>
                        <groupId>net.serenity-bdd</groupId>
                        <artifactId>serenity-core</artifactId>
                        <version>${serenity.version}</version>
                        <exclusions>
                            <exclusion>
                                <groupId>org.htmlunit</groupId>
                                <artifactId>htmlunit</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.seleniumhq.selenium</groupId>
                                <artifactId>htmlunit3-driver</artifactId>
                            </exclusion>
                            <!-- 同上：聚合阶段不驱动浏览器，driver 栈（含 devtools 传递依赖）无用；
                                 且插件 realm 里它们是 4.38.0，与项目侧钉定的 4.23.1 版本偏斜。
                                 selenium-api / selenium-support 刻意保留：serenity 公开 API 签名引用它们
                                 （org.openqa.selenium.support.ui.*），排除会导致聚合阶段类加载失败。 -->
                            <exclusion>
                                <groupId>org.seleniumhq.selenium</groupId>
                                <artifactId>selenium-java</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.seleniumhq.selenium</groupId>
                                <artifactId>selenium-chrome-driver</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.seleniumhq.selenium</groupId>
                                <artifactId>selenium-firefox-driver</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.seleniumhq.selenium</groupId>
                                <artifactId>selenium-edge-driver</artifactId>
                            </exclusion>
                            <exclusion>
                                <groupId>org.seleniumhq.selenium</groupId>
                                <artifactId>selenium-ie-driver</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                    <dependency>
                        <groupId>io.cucumber</groupId>
                        <artifactId>cucumber-core</artifactId>
                        <version>${cucumber.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>io.cucumber</groupId>
                        <artifactId>cucumber-java</artifactId>
                        <version>${cucumber.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>io.cucumber</groupId>
                        <artifactId>datatable</artifactId>
                        <version>${cucumber.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>serenity-reports</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/serenity</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              JaCoCo：覆盖率探针（prepare-agent 在父 pom 注入）。
              当前单元测试为“行为护盾”（Mockito 隔离，验证委派转发），并不执行 framework-web 实现，
              故 framework-web 行覆盖率约 0%；覆盖率“只升不降”门禁（check）待 T1-9 补充真实覆盖测试后启用。
              此处仅出报告（聚焦刚拆分的 BasePage 包），便于 CI/人工查看覆盖缺口。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ⭐ 汇总报告生成（原 T2-8 自动化）：本模块内联 exec-maven-plugin 在 verify 阶段触发，
                 生命周期上晚于上方 serenity:aggregate 所在的 post-integration-test，
                 顺序由 Maven 阶段保证，不再依赖同阶段内的插件声明顺序。
                 仅本模块（唯一含 framework-reporting 的业务测试模块）执行，根与框架模块不触发。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-summary-report</id>
                        <phase>${summary.report.phase}</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.hsbc.cmb.hk.dbb.automation.framework.common.reporting.SummaryReportGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/site/serenity</argument>
                            </arguments>
                            <!-- 必须用 test 作用域：SummaryReportGenerator 依赖 net.thucydides.model.*（serenity-model），
                                 而本模块把 serenity-model 显式声明为 <scope>test</scope>（ENG-P0-2）——Maven 的「最近声明优先」
                                 会让它不再以 compile 作用域传递，故 classpathScope=compile 时运行期 NoClassDefFoundError
                                 （SystemEnvironmentVariables），导致 mvn verify（CI/E-6）在汇总报告处必然失败。 -->
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          ⭐ 引擎级并行（评审08类-4 / X-1 / W-5）：需在隔离前置（C-1 用例级绑定）闭环后启用。
          显式 -Pparallel 才开启 cucumber/junit 并行；默认 mvn test/verify 仍串行，安全。
        -->
        <profile>
            <id>parallel</id>
            <properties>
                <!-- CON-1 引擎级并行：并发度旋钮（CI 用 -Dparallelism=N -DmaxPoolSize=M 覆盖） -->
                <parallelism>4</parallelism>
                <maxPoolSize>8</maxPoolSize>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- 开启 Cucumber 引擎级并行（默认串行，仅 -Pparallel 生效） -->
                                <cucumber.execution.parallel.enabled>true</cucumber.execution.parallel.enabled>
                                <cucumber.execution.parallel.config.fixed.parallelism>${parallelism}</cucumber.execution.parallel.config.fixed.parallelism>
                                <cucumber.execution.parallel.config.fixed.max-pool-size>${maxPoolSize}</cucumber.execution.parallel.config.fixed.max-pool-size>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
