<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      D2-4：接管 msg 转换词 —— 所有 %msg / %m 输出前统一脱敏（出口强制）。
      conversionRule 必须声明在 appender 之前。
    -->
    <conversionRule conversionWord="msg"
                    converterClass="com.hsbc.cmb.hk.dbb.automation.framework.common.logging.SanitizingMessageConverter"/>

    <!--
      C-2 / L-1：接管 ex 转换词 —— 异常栈（%ex）写出前统一脱敏；脱敏失败输出 [LOG SUPPRESSED] 而非原文。
      conversionRule 必须声明在 appender 之前。
    -->
    <conversionRule conversionWord="ex"
                    converterClass="com.hsbc.cmb.hk.dbb.automation.framework.common.logging.SanitizingThrowableConverter"/>

    <!--
      D3-1：MDC 由 framework.common.logging.LogContext 写入（scenarioId / threadId），
      用于并行执行后按用例回放日志；`LogContext.endScenario()` 在场景收尾解绑，
      避免 Cucumber 线程池复用导致的跨用例串扰。
      （原 %X{env} 已移除：本框架无全局「环境」标量来源，该列恒为 unknown，属误导性死列。）
    -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} [%thread] [%X{scenarioId}] %-5level %logger{36} - %msg%n"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{threadId}] [%X{scenarioId}] %-5level %logger{36} - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <encoding>UTF-8</encoding>
        </encoder>
    </appender>

    <!-- 滚动文件输出（D3-1）：落盘到 target/logs，便于 CI 归档与并行排障 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/framework.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>target/logs/framework.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!--
              单次全量测试运行日志量可达数十 MB；阈值过小会在运行<b>中途</b>滚动，
              导致刚写入的内容被归档（曾使依赖落盘内容的断言偶发失败）。故放宽到 256MB。
            -->
            <maxFileSize>256MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <encoding>UTF-8</encoding>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!--
      项目日志级别（2026-09-28 修正）：
      原写法包名写反了（com.hsbc.cmb.dbb.hk.automation vs 真实包 com.hsbc.cmb.hk.dbb.automation），
      属死配置；且即便写对，固定 DEBUG 也会让框架详细日志刷屏 —— 详细日志正确开关是
      framework.verbose.logging（VerboseLogging 会把本项目包 logger 提到 DEBUG）。
      故此处保持基线 INFO：默认只输出关键信息。
    -->
    <logger name="com.hsbc.cmb.hk.dbb.automation" level="INFO"/>

    <!--
      CT 耗时探针（2026-10-10）：PlaywrightContextManager.closeContext 的 [CT] TRACE 计时日志，
      用于收集 SIT 真实 context close 分布、定标 CloseGuard.CONTEXT_CLOSE_LIMIT_MS=1500。
      TRACE 仅输出两行耗时（close 段 + 总链路），收集完毕后可删除本 logger 或改回 INFO。
    -->
    <logger name="com.hsbc.cmb.hk.dbb.automation.framework.web.lifecycle.bootstrap.PlaywrightContextManager" level="TRACE"/>
    
    <!-- Playwright 日志级别 -->
    <logger name="com.microsoft.playwright" level="WARN"/>
    
    <!-- Serenity 日志级别 -->
    <logger name="net.serenitybdd" level="INFO"/>
    <logger name="net.thucydides" level="INFO"/>
    
    <!-- Cucumber 日志级别 -->
    <logger name="io.cucumber" level="INFO"/>
</configuration>
