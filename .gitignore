# ============================================================================
# test-automation（独立构建单元）版本控制忽略规则
#   本仓库只应包含：pom.xml、spotbugs-exclude.xml、src/**
#   —— 其余均为构建产物 / 运行期缓存 / 崩溃转储，绝不入库。
# ============================================================================

# ---------- 构建产物（Maven：classes/jars/报告/serenity 站点；实测 320MB）----------
target/
**/target/

# ---------- Playwright 浏览器缓存（由 mvn exec ... playwright CLI install 生成；勿入库）----------
.playwright/

# ---------- JVM 崩溃转储与回放日志（HS 错误日志，含环境信息）----------
hs_err_pid*.log
replay_pid*.log
*.hprof

# ---------- 测试运行期产物 ----------
downloads/
screenshots/
traces/
*.trace.zip

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.swp

# ---------- 操作系统 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 本地凭据/环境覆盖（凭据一律经环境变量或 CI Secrets 注入，绝不入库）----------
*.local
.env
.env.*
!/.env.example
*.p12
*.jks
*.pfx
*.key

# ---------- 调试/诊断临时产物（实测长期以 untracked 形态堆积，add -A 时极易误入库）----------
# 根目录日志/转储（仅锚定根，避免误伤 src 下的黄金文件等 .txt 测试资源）
/1.txt
/2.txt
/e2e_*.txt
/sf*.txt
/fs_desc.txt
/lay.txt
/mt.txt
/verify_run*.log
*.log
# 运行期采集转储 json（仅锚定根目录，避免误伤 src/test/resources 下的夹具/黄金文件）
# 实测反复以 untracked 形态堆积（insight-retrieve / leftmenu-permissionLeftMenuConfig /
# pinned-account / profile-list），add -A 时极易误入库；真实响应夹具请放 src/test/resources/mocks/**
/*.json
# 一次性调试脚本（_fix_* / _diag_* / _clean_diag* / BOM 变体）
_fix_*.ps1
_diag_*.ps1
_clean_diag*.ps1
*_bom.ps1
# 误用未展开属性的构建目录（根名就叫 ${project.build.directory}）与临时 io 目录
/${project.build.directory}/
/io/
